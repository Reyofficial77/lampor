theme_override_colors/font_color = Color(1, 0.8, 0.3, 1)
theme_override_font_sizes/font_size = 20
text = "PANDUAN KONTROL & ITEM"
horizontal_alignment = 1

[node name="Text" type="RichTextLabel" parent="PauseMenu/PauseGuidePanel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "[b]KONTROL:[/b]
• [W,A,S,D]: Bergerak
• [SHIFT]: Lari Sprint
• [E]: Interaksi (Buka/Tutup Pintu, Sembunyi, Ambil Item, Nyalakan Obor)
• [F]: Senter On/Off
• [1-4]: Pilih Slot Item
• [G]: Jatuhkan/Drop Item yang dipegang
• [ESC]: Jeda / Buka Menu Pause
• [KLIK / ENTER]: Minum Jamu untuk pulihkan Sanity & Stamina

[b]TIPS BERTAHAN HIDUP:[/b]
1. [color=red]Jangan menatap langsung ke Lampor![/color]
2. Matikan senter dan sembunyi di lemari saat lonceng berdentang.
3. Obor penolak bala yang menyala adalah safe zone."

